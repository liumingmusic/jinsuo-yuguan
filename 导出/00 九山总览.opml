<?xml version="1.0" encoding="UTF-8"?>
<opml version="2.0">
  <head>
    <title>金锁玉关 · 坎坤震九山总览</title>
  </head>
  <body>
    <outline text="金锁玉关 · 坎坤震九山总览">
      <outline text="这份导图怎么用">
        <outline text="三张分图：坎、坤、震，一卦一张" />
        <outline text="每张先看「卦论断→卦见水→卦见砂→应期→兼卦」" />
        <outline text="再看三山：中间山主健康，两侧山主人事" />
        <outline text="网页正文与导图同一份源，改一处两边变" />
        <outline text="导图是骨架，细节在正文对应锚点" />
      </outline>
      <outline text="一卦三山总规律">
        <outline text="中间山主健康／身体" />
        <outline text="两侧山主人事，人事应完才落到身体" />
        <outline text="坎：子（中）＝精气神；壬癸＝财与理财" />
        <outline text="坤：坤（中）＝妇科子宫；未申＝利润与链接" />
        <outline text="震：卯（中）＝肝与关节；甲乙＝劲与用法" />
        <outline text="三山常成一对阴阳：壬癸、甲与乙、未与申" />
        <outline text="三元龙：地元龙＝有没有，天元龙＝根本，人元龙＝怎么用" />
      </outline>
      <outline text="九山速查">
        <outline text="坎 · 壬子癸（一白）">
          <outline text="壬：财富能力、主阳｜见砂武贵，见水气虚" />
          <outline text="子：财库、家运｜见砂有钱库，见水漏底" />
          <outline text="癸：理财、主阴｜见砂女当家，见水妇难孕" />
          <outline text="一句话：一家的「藏」，藏得住才谈得上发" />
        </outline>
        <outline text="坤 · 未坤申（二黑）">
          <outline text="未：利润、以利为先｜见砂挣着了，见水挣不着" />
          <outline text="坤：家运、幸福感｜见砂贤妻良母，见水女主不幸福" />
          <outline text="申：链接、文昌｜见砂知书达理，见水剑走偏锋" />
          <outline text="一句话：一家的「养」，养得住人才有家运" />
        </outline>
        <outline text="震 · 甲卯乙（三碧）">
          <outline text="甲：行动力｜见砂一马当先，见水佛系躺平" />
          <outline text="卯：人脉、桃花｜见砂人脉生财，见水为他人做嫁衣" />
          <outline text="乙：文气、自处｜见砂文昌内秀，见水浪漫虚无" />
          <outline text="一句话：一家的「动」，动得对才叫奋起" />
        </outline>
      </outline>
      <outline text="技法总表">
        <outline text="三点定位">
          <outline text="第一代：用神卦＋对宫＋先天位" />
          <outline text="优化版：用神卦＋用神先天位＋关联诉求卦" />
          <outline text="边界：对宫相催只增强、不调整" />
        </outline>
        <outline text="兼卦">
          <outline text="三条件：跨卦＋一喜一恶＋相邻" />
          <outline text="后果：凶性转移，不是相加" />
        </outline>
        <outline text="临卦（邻卦）加强">
          <outline text="相邻两卦互相叠 buff，不必一喜一恶" />
          <outline text="例：未水丁砂、丁水未砂" />
        </outline>
        <outline text="四墓库">
          <outline text="辰戌丑未不作核心、不宜过强" />
          <outline text="例外：孩子太弱可微调" />
        </outline>
        <outline text="四官卦">
          <outline text="乾＝作风与领导，震＝实权，艮＝下属，离＝名气" />
          <outline text="也能调家运：家风、没劲、孩子、规划" />
        </outline>
        <outline text="元运">
          <outline text="上中元看坎坤震" />
          <outline text="离九运先调离" />
        </outline>
        <outline text="分龄核心卦">
          <outline text="二十岁调震、三十岁调坎、五十岁以上调坤" />
        </outline>
      </outline>
      <outline text="经文体例">
        <outline text="一山一篇，篇内两栏：我的经文 / 老师口播" />
        <outline text="我的经文目前全部待补，等整体理过一版再填" />
        <outline text="老师口播现在收了坤卦的卦体、未山、坤山" />
        <outline text="没有的一律留占位〔待补〕，不代写" />
      </outline>
      <outline text="存疑清单（成书前必核）">
        <outline text="坎：兼亥山 vs 兼亥子" />
        <outline text="坎：子山「形如项囊袋」的囊袋形" />
        <outline text="坤：未水应三房，未砂应大中房，口径不一" />
        <outline text="坤：未砂「丑水照当坏」与「家和有余粮」正相反" />
        <outline text="坤：申水伤小女 vs 伤长女" />
        <outline text="坤：「把酒喝桑麻」疑为「话桑麻」" />
        <outline text="震：甲山先天位取艮还是取丙" />
        <outline text="震：三神过水法的中神／大神分配" />
        <outline text="震：「形若己案拱」疑为「几案」" />
        <outline text="震：「卯亥午戌」不可读成两个三合局" />
      </outline>
      <outline text="读的顺序">
        <outline text="先读Ⅰ课程线，懂理法怎么长出来" />
        <outline text="再读Ⅱ卦山线，一卦一页，逐山落地" />
        <outline text="Ⅲ作业线只作校验：老师改过的地方才是重点" />
        <outline text="附录最后读：经文对照、技法总表、存疑" />
        <outline text="技法章必须等九山写完再反推，不能倒着写" />
      </outline>
    </outline>
  </body>
</opml>