<?xml version="1.0" encoding="UTF-8"?>
<opml version="2.0">
  <head>
    <title>一白坎卦 · 壬子癸</title>
  </head>
  <body>
    <outline text="一白坎卦 · 壬子癸">
      <outline text="卦论断（一卦之体）">
        <outline text="一白坎：财库、家底、精气神" />
        <outline text="抗压容错率、逆商" />
        <outline text="生殖泌尿系统、下丹田" />
        <outline text="桃花" />
        <outline text="身体层：生殖泌尿、耳道、体液、肾功能" />
        <outline text="生活层：家运、财库、精气神" />
        <outline text="能力层：抗压、逆商、工作能力、性能力、桃花" />
        <outline text="一句话：坎是一家的「藏」，藏得住才谈得上发" />
      </outline>
      <outline text="卦见水">
        <outline text="总断：精气神差 → 财运不佳、妇科问题" />
        <outline text="定性三看：长期存在 / 流量大 / 连通它卦" />
        <outline text="坎流若巽 → 三房财不好" />
        <outline text="贫寒应：老二、老五、老八" />
        <outline text="水形七叉 → 家道中落" />
        <outline text="坎水入乾 → 老父旺、父亲乖" />
        <outline text="坎水入艮 → 兴三房、老三俊" />
        <outline text="坎乾艮三连 → 吉在水口、坎必凶" />
        <outline text="坎水入巽 → 老大老二绝嗣，老三稍好" />
        <outline text="坎兑离都见水 → 先贫后富、妻子贤惠" />
        <outline text="坎水＋兑离砂 → 二五八子无后" />
        <outline text="坎水＋兑震水 → 意外得财，拿命换的〔待校〕" />
        <outline text="为什么：坎为藏，水把「藏」变成「泄」" />
      </outline>
      <outline text="卦见砂">
        <outline text="坎全砂 → 富贵，二房发" />
        <outline text="环抱砂最优：形优美、隔溪隔水、不逼压宫" />
        <outline text="砂太近 → 不分房份，皆应" />
        <outline text="中间断（寒透风）→ 二房丁损财耗" />
        <outline text="无离水相配 → 孤单贫〔待校〕" />
        <outline text="坎砂＋艮砂 → 老三应凶、绝嗣" />
        <outline text="坎砂＋艮乾砂 → 老三无子、求财难" />
        <outline text="一句话：坎要「实」，实才藏得住" />
      </outline>
      <outline text="卦应期">
        <outline text="子年兴家、午年败家" />
        <outline text="时→日→月→年，能量逐级提升" />
        <outline text="日应只到头疼腰疼，年月才应「灾殃」" />
      </outline>
      <outline text="卦兼（四组）">
        <outline text="壬亥兼水 → 血糖、糖尿病、血稠、造血弱" />
        <outline text="壬亥兼砂 → 严重肾病、脑疾" />
        <outline text="癸丑兼水 → 得肾病" />
        <outline text="癸丑兼砂 → 结石、左脚扭伤" />
        <outline text="兼的前提：跨卦 + 一喜一恶 + 相邻（三条件同时满足）" />
        <outline text="后果：凶性在两卦间转移，不是相加" />
      </outline>
      <outline text="一卦三山总纲">
        <outline text="中间山主健康，两侧山主人事" />
        <outline text="坎：子居中 → 身体；壬癸 → 人事" />
        <outline text="三山共一个「藏」字：壬藏气、子藏神、癸藏血" />
        <outline text="壬癸应个人，子应全家" />
        <outline text="房份：坎应二房，兼看一四七 / 二五八 / 三六九" />
      </outline>
      <outline text="壬山 · 财富能力（主阳）">
        <outline text="身体层">
          <outline text="肾阳、男性之力、前列腺" />
          <outline text="精力不足、懒、腰疼" />
          <outline text="阳虚：驼背、点头哈腰、自卑" />
        </outline>
        <outline text="见水">
          <outline text="壬水没儿郎，先绝是二房" />
          <outline text="形如一箭去 → 小口命难长" />
          <outline text="形如葫芦样（倒扣＝凹风煞）→ 腰肾伤" />
          <outline text="四季澄清蓄 → 淋浊、疝气" />
          <outline text="水少而清：能有子但穷" />
          <outline text="水大势猛：能富贵但子嗣难" />
        </outline>
        <outline text="见砂">
          <outline text="壬砂高大发武贵" />
          <outline text="出入佳备振海内" />
          <outline text="再得丙水来对照 → 文武双全" />
          <outline text="若是庚水来相遇 → 三点成局" />
          <outline text="壬砂丙水见庚水 → 必出官员大富豪" />
        </outline>
        <outline text="形煞">
          <outline text="一箭去：水流直去 / 楼梯直下" />
          <outline text="葫芦倒扣：四面山夹、水汇其中" />
          <outline text="壬亥火尖砂：头脑血压病" />
          <outline text="脏臭水：病煞并上" />
        </outline>
        <outline text="兼亥（坎 + 乾）">
          <outline text="三条件：跨卦 + 一喜一恶 + 相邻" />
          <outline text="壬水兼亥：老父受气、官非、三高" />
          <outline text="壬砂兼亥：中年男子痛风、血压、偏头痛" />
        </outline>
        <outline text="技法">
          <outline text="三点定位：本卦 + 对宫 + 先天位" />
          <outline text="对宫相催：只放大、不矫正" />
          <outline text="飘转（布局用飘、论断用挖）" />
        </outline>
        <outline text="我的经文与老师口播">
          <outline text="我的经文：壬水汪汪阳气亏，二子身弱少作为" />
          <outline text="老师口播：〔待补〕" />
        </outline>
      </outline>
      <outline text="子山 · 财库（家运）">
        <outline text="身体层">
          <outline text="精气神" />
          <outline text="肾虚：没劲儿、高兴不起来、想躺平摆烂" />
          <outline text="深挖到坤 → 女主人同病" />
        </outline>
        <outline text="人事层">
          <outline text="财库：存钱能力、家底、固定资产" />
          <outline text="家运：一年比一年小" />
          <outline text="逆商、抗压、事业根基" />
          <outline text="夫妻生活的频率" />
        </outline>
        <outline text="定位">
          <outline text="根器：能量本源、一个家的根系" />
          <outline text="中间山：断坎卦先看子" />
          <outline text="财四卦（坎坤巽兑）之坎＝财库" />
        </outline>
        <outline text="见水">
          <outline text="子水一条沟，流去不回头" />
          <outline text="无子身逃外，凶死一笔勾" />
          <outline text="形如项囊袋，妇女把命休" />
          <outline text="坎主中男，先天坤在此 → 应在女主" />
          <outline text="财库穿底：存款卡在某个数" />
          <outline text="家运败落（最重）" />
        </outline>
        <outline text="三要素">
          <outline text="大小：水管 / 池 / 河" />
          <outline text="形态：有没有形煞（最关键）" />
          <outline text="质量：臭水比形煞还凶" />
        </outline>
        <outline text="应期">
          <outline text="鼠马年月见灾殃" />
          <outline text="格局看三合，形煞看对冲" />
          <outline text="本宫落七星某局 → 申子辰也应" />
        </outline>
        <outline text="见砂">
          <outline text="子砂定发富，家有金钱库" />
          <outline text="存钱能力，不是挣钱能力" />
          <outline text="远近无水照，丑名亦不顾" />
          <outline text="子午火尖砂：大房伤亡、二房盲" />
          <outline text="好砂：端正高大聚气 → 人财两得" />
          <outline text="坏砂：破军 → 家丑、婚变、精气神散" />
        </outline>
        <outline text="组合">
          <outline text="子水 + 午水：桃花局（又菜又爱玩）" />
          <outline text="子砂 + 午路直射：心脏（离主二女、二媳）" />
          <outline text="子砂 + 先天乾有煞：有财无运、富而不贵" />
          <outline text="子砂 + 酉砂：饮水机——能喝，全是渣" />
          <outline text="子水连壬 → 老二；兼丑 → 老五；水大 → 二五八" />
        </outline>
        <outline text="形煞">
          <outline text="凹风煞：正北凹陷，必须补宫" />
          <outline text="项囊袋：中间大两头小" />
          <outline text="火尖砂：三角（塔、盐灯、顶棚）" />
          <outline text="破军：砂形凌乱七叉" />
        </outline>
        <outline text="技法">
          <outline text="子位宜砂（1234 喜砂）" />
          <outline text="午位宜水，但对宫相催只增强不调整" />
          <outline text="本宫见水再催午水 → 桃花局" />
          <outline text="现代判法：冰箱判砂，开盖鱼缸判真水" />
        </outline>
        <outline text="我的经文与老师口播">
          <outline text="我的经文：子水一沟不回头，财库穿底万事休" />
          <outline text="老师口播：〔待补〕" />
        </outline>
      </outline>
      <outline text="癸山 · 理财能力（主阴）">
        <outline text="身体层">
          <outline text="肾阴、子宫、妇科、内分泌" />
          <outline text="宫寒、月经不调、腰疼" />
          <outline text="取象：卵子、性生活、例假" />
        </outline>
        <outline text="人事层">
          <outline text="理财能力：不是赚，是守" />
          <outline text="主女性、中女" />
        </outline>
        <outline text="见水">
          <outline text="癸水夫不遇，常为夫羞辱" />
          <outline text="形若不齐正，犹被骄姑逐" />
          <outline text="形若一条枪，毒死夫常哭" />
          <outline text="单纯阴虚：好老婆，就是生不出" />
          <outline text="有形煞：阴虚阳亢，骄横、PUA" />
          <outline text="癸方有水妇不育，痛经白带子宫瘤" />
        </outline>
        <outline text="对宫丁山">
          <outline text="丁水相催：只增强、不调整" />
          <outline text="丁砂叠加：左脑疼痛、中风" />
          <outline text="丁砂（辛砂）：家财官非医药花" />
        </outline>
        <outline text="见砂">
          <outline text="癸砂女当家，发在上元花" />
          <outline text="不问男何汉，惧内定数他 → 今读作尊重" />
          <outline text="形若葫芦样，矮郎要怕他" />
          <outline text="女主能发家" />
          <outline text="癸砂 + 丁水：丁财两旺" />
        </outline>
        <outline text="兼丑（艮）">
          <outline text="癸丑兼砂：左脚伤、抽筋、崴脚" />
          <outline text="癸丑兼水：得肾病" />
          <outline text="癸水见丑砂：晚得子、胃疼、糖尿病" />
        </outline>
        <outline text="形煞">
          <outline text="一条枪：直冲直扎" />
          <outline text="不齐正：水形歪斜" />
          <outline text="葫芦样：灶连灶、砂两叠" />
          <outline text="火尖砂：三角" />
        </outline>
        <outline text="技法">
          <outline text="女性能量局：癸 + 艮 + 巳 + 丁" />
          <outline text="不成局，不用三点定位" />
          <outline text="六杯清水 + 墨汁 + 黑曜石（临时法）" />
          <outline text="兴奋类违禁品：癸山为核心" />
          <outline text="致幻剂：亥山、巳山" />
        </outline>
        <outline text="我的经文与老师口播">
          <outline text="我的经文：癸水潺潺妇难孕，夫妻缘浅灶头凉" />
          <outline text="老师口播：〔待补〕" />
        </outline>
      </outline>
      <outline text="断卦次序">
        <outline text="一 看子：还有没有神" />
        <outline text="二 看壬：这个男人立不立得住" />
        <outline text="三 看癸：女性与钱守不守得住" />
        <outline text="四 三山见水：先定级，再谈应事落谁头上" />
        <outline text="五 催之前看本宫：本宫是水，越催越坏" />
        <outline text="四级递进（壬）">
          <outline text="一级：单纯见水，阳气弱" />
          <outline text="二级：成形煞，阳虚症状" />
          <outline text="三级：腰疼腰酸、懒、直不起腰" />
          <outline text="四级：形煞大 + 形不好 + 水质差 → 不育、延及母亲" />
        </outline>
      </outline>
    </outline>
  </body>
</opml>