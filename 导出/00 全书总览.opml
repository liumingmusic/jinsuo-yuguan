<?xml version="1.0" encoding="UTF-8"?>
<opml version="2.0">
  <head>
    <title>金锁玉关 · 全书总览</title>
  </head>
  <body>
    <outline text="金锁玉关 · 全书总览">
      <outline text="先说这是什么">
        <outline text="二十四山为全图，一山十五度" />
        <outline text="八宫各统三山，卦看格局、山看落点" />
        <outline text="当前精读坎、坤、震三卦九山" />
        <outline text="内容只有一份 Markdown 源" />
        <outline text="网页、导图、书稿同源生成，不互相转抄" />
        <outline text="底本：12 讲课程笔记、经文讲义、老师批语" />
      </outline>
      <outline text="四条线怎么分工">
        <outline text="Ⅰ 课程线（12 页，一讲一页）">
          <outline text="写：理法与技法怎么一步步推进" />
          <outline text="写：为什么先判砂水、再取用神、再立太极、最后逐山解经" />
          <outline text="不写：经文逐句细目（在 Ⅱ 线）" />
          <outline text="不写：老师批语原文（在 Ⅲ 线）" />
        </outline>
        <outline text="Ⅱ 卦山线（3 页，一卦一页）">
          <outline text="写：卦体（论断／见水／见砂／应期／兼卦）" />
          <outline text="写：三山各八段，见水见砂、形煞、技法、自译经文" />
          <outline text="写：差异与存疑，底本冲突逐条留痕" />
          <outline text="不写：把课堂案例再讲一遍（在 Ⅰ 线）" />
        </outline>
        <outline text="Ⅲ 作业线（12 页：总表＋11 次）">
          <outline text="写：题面、老师批语、答案落在哪一节" />
          <outline text="写：状态看板（已完成／未完成、已批阅／未批阅）" />
          <outline text="不写：把 Ⅱ 已讲的话再说一遍" />
        </outline>
        <outline text="附录（5 篇，跨页公共件）">
          <outline text="经文对照总表" />
          <outline text="技法总章" />
          <outline text="术语表" />
          <outline text="存疑清单" />
          <outline text="二十四山速查" />
        </outline>
      </outline>
      <outline text="四种读法">
        <outline text="想系统学：Ⅰ 线从第 1 讲顺序读" />
        <outline text="想查一座山：Ⅱ 线按卦进，或首页罗盘按山点" />
        <outline text="想知道老师怎么判：Ⅲ 线看批语与「已判过的错」" />
        <outline text="想先看骨架：本图，再看九山总览与三卦分图" />
      </outline>
      <outline text="十二讲推进">
        <outline text="1 预热课：金锁凭什么值得学" />
        <outline text="2 宏观大局与砂水：判准从哪来" />
        <outline text="3 子山根器：先学自身" />
        <outline text="4 壬山与金锁用神：相中取独" />
        <outline text="5 坎卦三山经文（上）" />
        <outline text="6 坎卦三山经文（下）" />
        <outline text="7 坤卦（上）：四海之内都哥们" />
        <outline text="8 坤卦（下）" />
        <outline text="9 坤卦三山经文" />
        <outline text="10 震·奋起：净场增局" />
        <outline text="11 震卦三山经文（上）" />
        <outline text="12 震卦三山经文（下）" />
      </outline>
      <outline text="九山已成篇">
        <outline text="坎 · 壬子癸（一白）·藏">
          <outline text="壬：财商，敢不敢挣" />
          <outline text="子：财库，存不存得住" />
          <outline text="癸：理财，守不守得住" />
        </outline>
        <outline text="坤 · 未坤申（二黑）·养">
          <outline text="未：利润，先谈利益" />
          <outline text="坤：家运，养不养人" />
          <outline text="申：链接，通不通外" />
        </outline>
        <outline text="震 · 甲卯乙（三碧）·动">
          <outline text="甲：有没有劲" />
          <outline text="卯：跟谁互动" />
          <outline text="乙：怎么用" />
        </outline>
      </outline>
      <outline text="一卦三山总规律">
        <outline text="中间山主健康与身体" />
        <outline text="两侧山主人事，人事应完才落到身体" />
        <outline text="三山常成一对阴阳：壬癸、甲与乙、未与申" />
        <outline text="三元龙：地元＝有没有，天元＝根本，人元＝怎么用" />
      </outline>
      <outline text="作业与批阅">
        <outline text="11 次作业" />
        <outline text="已交 5，未交 6" />
        <outline text="已批阅 3，待批 2，未交未批 6" />
        <outline text="六至十一是按题面回填，不是实际提交" />
        <outline text="状态改动只动 _数据/作业状态.json" />
      </outline>
      <outline text="六条硬口径（判过的错）">
        <outline text="火尖砂，不叫破军砂" />
        <outline text="马路算砂，不当虚看" />
        <outline text="冰箱判砂，不判水" />
        <outline text="真水最强，看蒸发" />
        <outline text="三合是同一件事的三个阶段，不是同一五行" />
        <outline text="只有大太极、小太极，没有中太极" />
      </outline>
      <outline text="还没做完">
        <outline text="余下五卦十五山未讲" />
        <outline text="震卦自译经文是试作，等老师版替换" />
        <outline text="存疑条目待原音与讲义复核" />
        <outline text="课程线的图只留了位置，待补图" />
      </outline>
    </outline>
  </body>
</opml>