<?xml version="1.0" encoding="UTF-8"?>
<opml version="2.0">
  <head>
    <title>三碧震卦 · 甲卯乙</title>
  </head>
  <body>
    <outline text="三碧震卦 · 甲卯乙">
      <outline text="震为雷 · 易经（䷲ 震下震上）">
        <outline text="卦辞：震，亨。震来虩虩，笑言哑哑。震惊百里，不丧匕鬯。" />
        <outline text="彖：震来虩虩，恐致福也；笑言哑哑，后有则也；震惊百里，惊远而惧迩也；出可以守宗庙社稷，以为祭主也。" />
        <outline text="象：洊雷，震；君子以恐惧修省。" />
        <outline text="爻辞">
          <outline text="初九：震来虩虩，后笑言哑哑，吉。" />
          <outline text="六二：震来厉，亿丧贝，跻于九陵，勿逐，七日得。" />
          <outline text="六三：震苏苏，震行无眚。" />
          <outline text="九四：震遂泥。" />
          <outline text="六五：震往来厉，亿无丧，有事。" />
          <outline text="上六：震索索，视矍矍，征凶。震不于其躬，于其邻，无咎。婚媾有言。" />
        </outline>
      </outline>
      <outline text="卦论断（一卦之体）">
        <outline text="三碧震：长男、奋起、正官" />
        <outline text="事业、行动力、后天成长的机缘与天赋" />
        <outline text="肝、胆、筋骨、手指" />
        <outline text="成长上限：不给起跑线，给后劲" />
        <outline text="四官卦之「实权」：政令能不能传下去" />
        <outline text="一句话：震不是天赋，是「肯不肯一直干」" />
      </outline>
      <outline text="卦取象 · 震为动 147">
        <outline text="震为动：行动力、官、突破、纠纷、肝胆、面部神经、关节、臂腰侧" />
        <outline text="甲（上进、创新、低、高级欲望）" />
        <outline text="卯（遍地开花、成败于人脉周边力量、为他人做嫁衣、超前消费、贷款、做牛马、关节）" />
        <outline text="乙（浪漫、文昌、肝郁）" />
      </outline>
      <outline text="卦见水">
        <outline text="三碧沟塘破，其家定遭祸" />
        <outline text="两个来源：行动力不足（一屋懒蛋）／行动力滥用（乱投乱闯）" />
        <outline text="长房不损丁即损财；有财则无子或败家子" />
        <outline text="流神通巽地 → 官飞巳次过；家庭纷争不断" />
        <outline text="艮水若交会 → 兄弟反目、争斗官司" />
        <outline text="震水入巽 → 女盗夫君男换妻" />
        <outline text="震艮两卦水聚 → 长房贫寒兴三房" />
        <outline text="大房先贫后富贵 → 艮水流入乾" />
        <outline text="震水遇兑艮砂 → 一四七房绝" />
        <outline text="应期：三碧之运、酉年尤验" />
        <outline text="一句话：水把「动」变成「乱」" />
      </outline>
      <outline text="卦见砂">
        <outline text="三碧全体砂，文武共兴家" />
        <outline text="若配乾兑水 → 上中一鲜花" />
        <outline text="形若贪狼样 → 人秀分外嘉（起伏有致、刚健）" />
        <outline text="震位高大乾兑水 → 执政官权众民夸" />
        <outline text="再显艮水配合 → 各房齐达" />
        <outline text="相连艮卦山 → 官权高贵缺儿郎" />
        <outline text="震巽砂配乾艮水 → 官贵与富豪" />
        <outline text="官贵不顾离有水 → 退出官场又经商" />
        <outline text="一句话：震要「满」，满则成官局" />
      </outline>
      <outline text="卦应期与元运">
        <outline text="上元、中元（一二三四运）最灵" />
        <outline text="三碧之运、酉年尤验" />
        <outline text="现为离九运：先调离，震作辅" />
        <outline text="分龄：二十岁调震、三十岁调坎、五十岁调坤" />
      </outline>
      <outline text="卦兼与邻卦">
        <outline text="先天位取艮（东北）：震在先天居东北" />
        <outline text="震位所藏先天为离：三点定位取丙（正南）" />
        <outline text="对宫兑（西）：水则口舌、砂则官司手术" />
        <outline text="邻卦巽（东南）：长男长媳，家庭氛围" />
        <outline text="邻卦艮（东北）：兄弟宫，也管子孙" />
        <outline text="两说并存：先天位取艮或取丙，三点定位取丙" />
      </outline>
      <outline text="技法 · 四官卦">
        <outline text="乾（西北）：作风、领导支持、贵人" />
        <outline text="震（正东）：执行力、实权" />
        <outline text="艮（东北）：群众基础、下属" />
        <outline text="离（正南）：名气、开明、眼光" />
        <outline text="为官四问：上面支持？自己干得动？下面配合？名声眼光？" />
        <outline text="调家运：家风调乾、没劲调震、孩子调艮、规划调离" />
        <outline text="震与艮分工：震是自己干不干得动，艮是下面配不配合" />
      </outline>
      <outline text="一卦三山总纲">
        <outline text="中间山主健康，两侧山主人事" />
        <outline text="卯居中 → 肝与关节；甲乙 → 有没有劲、怎么用" />
        <outline text="三山讲同一股「动」的三层" />
        <outline text="甲＝地元龙（实际含义：有没有）" />
        <outline text="卯＝天元龙（根本内涵：跟谁）" />
        <outline text="乙＝人元龙（人性影响：怎么用）" />
      </outline>
      <outline text="甲山 · 行动力（奋进之力）">
        <outline text="身体层">
          <outline text="胆、肝、脑神经、面部神经" />
          <outline text="面瘫、抽、阴阳脸（左右不对称）" />
          <outline text="腹胀、肝腹水、胆结石、偏头痛" />
        </outline>
        <outline text="见水">
          <outline text="甲水主贫穷，长房不兴隆" />
          <outline text="「贫穷」今译：佛系、躺平、平凡、小市民" />
          <outline text="形若斜飞去 → 长房绝踪（娶不下、没人跟）" />
          <outline text="黄肿大等胀 → 黄疸、肝腹水" />
          <outline text="肝胆疾病并头痛 → 结石多应长房" />
          <outline text="甲水见兑水 → 又穷又爱吹，酒后骂人" />
          <outline text="甲寅兼真水 → 疯癫、半身不遂、面瘫（应家中男性）" />
          <outline text="病理链：懒 → 不出汗 → 抑郁 → 肝郁 → 病" />
        </outline>
        <outline text="见砂">
          <outline text="一马不断甲龙官 → 一马当先" />
          <outline text="上中时势大吉风 → 上中元最旺" />
          <outline text="若得庚酉波浪起 → 后劲，运势不绝" />
          <outline text="若在湖中连天涌 → 人中龙凤" />
          <outline text="甲山酉水逆坤流 → 水火既济" />
          <outline text="甲庚对宫两并砂 → 富贵不全缺儿郎、官场牢狱" />
          <outline text="甲峰如见丙庚水 → 富贵双全" />
          <outline text="震卦独有一条：对宫水必须大、必须连波" />
        </outline>
        <outline text="兼与叠加">
          <outline text="甲寅（艮）兼水 → 对宫相催，矛盾转给艮" />
          <outline text="甲水＋兑水 → 对宫增益，口舌之相" />
          <outline text="甲庚两砂 → 富而有患：口舌、牢狱、子孙" />
        </outline>
        <outline text="技法">
          <outline text="普通三点：甲＋艮＋兑（求事业）" />
          <outline text="升级三点：甲＋兑＋丙（求名、粉丝、流量）" />
          <outline text="三神过水法：小神→中神→大神，留财用" />
          <outline text="布局：甲山博古架/泰山石；对宫大鱼缸动水" />
          <outline text="忌：把甲山做成形煞" />
        </outline>
        <outline text="我的经文与老师经文">
          <outline text="我的经文：〔待补〕" />
          <outline text="老师经文：〔待补〕" />
        </outline>
        <outline text="一句话：见砂一马当先，见水佛系躺平" />
      </outline>
      <outline text="卯山 · 人脉（琼林与桃花）">
        <outline text="身体层">
          <outline text="肝、四肢、十指、毛发、关节" />
          <outline text="食指特殊：六指、脚趾异常、腱鞘炎" />
          <outline text="正东见水＋正西见砂 → 阴阳颠倒，手脚有亏" />
        </outline>
        <outline text="见水">
          <outline text="卯水属同人，先富小财神" />
          <outline text="家物他人有，伯道在本身" />
          <outline text="形如方深聚，近对作城门 → 先吉后凶" />
          <outline text="现代：钱花不到刀刃、为他人做嫁衣" />
          <outline text="贷款型：花呗、房贷、车贷，给银行打工" />
          <outline text="大方型：别人借钱都借得到" />
          <outline text="男性：养小三、大保健，钱花给别人" />
          <outline text="卯水再见酉水 → 飘浮淫秽破家婚、左手缺指" />
          <outline text="两条投资禁忌：坎卦坏、卯山见水" />
        </outline>
        <outline text="见砂">
          <outline text="卯砂能致富，血财发无涯" />
          <outline text="长子风四海，性好采野花" />
          <outline text="形若己案拱 → 威名振三通（红顶商人）" />
          <outline text="形如鸡爪样 → 军贼产其家" />
          <outline text="若照单酉水 → 多生女娃娃" />
          <outline text="酉水照 → 女秀文艺男理财" />
          <outline text="再见艮位添秀水 → 人丁财旺懂孝礼" />
          <outline text="午尖砂 → 长房突命亡（心脏）" />
          <outline text="血财靠人脉：中介、平台、婚介" />
        </outline>
        <outline text="兼与叠加">
          <outline text="卯砂＋酉水 → 生女孩技术，+20% 几率" />
          <outline text="卯水＋酉水 → 婚姻破、手部应灾" />
          <outline text="午尖砂 → 心、血压、眼疾" />
          <outline text="鸡爪形 → 出贼、出匪、职业打假" />
        </outline>
        <outline text="技法">
          <outline text="三点定位：卯砂＋艮水 → 丁财两旺" />
          <outline text="卯山要秀美环抱，忌怪石尖射" />
          <outline text="催人脉：卯砂为主、兑水为辅" />
          <outline text="应期：卯亥午戌四字并列，非三合" />
          <outline text="只按属相断：卯应兔、酉应鸡" />
        </outline>
        <outline text="我的经文与老师经文">
          <outline text="我的经文：〔待补〕" />
          <outline text="老师经文：〔待补〕" />
        </outline>
        <outline text="一句话：见砂人脉变钱，见水钱都花在别人身上" />
      </outline>
      <outline text="乙山 · 文气（如何自处）">
        <outline text="身体层">
          <outline text="肝、项部、头发、手指" />
          <outline text="肝郁气滞、久治不愈的肝病" />
          <outline text="乙辰水成形煞 → 女性乳房手术" />
        </outline>
        <outline text="见水">
          <outline text="乙水曲曲钩，叔嫂暗相偷" />
          <outline text="旧注「长男肝病不能满足妻子」→ 讲师明确否定" />
          <outline text="现代：浪漫主义过重、不切实际、伪文艺" />
          <outline text="形如破军样 → 肝疯病不休（肝郁化火）" />
          <outline text="临卦主运乱 → 流年甲卯乙时急转直下" />
          <outline text="大运三与七 → 财富不到头" />
          <outline text="乙辰见明水 → 女孩婚姻阻碍、性格霸道" />
          <outline text="乙水＋坤水 → 超级迷信，自修丹道" />
          <outline text="机制：不是懒，是「闲」出来的虚无" />
        </outline>
        <outline text="见砂">
          <outline text="乙砂发文章，几个读书郎" />
          <outline text="形似朝笏起 → 为官名显扬（力弱，不必过解）" />
          <outline text="形如笋笔样 → 翰墨字亦香" />
          <outline text="若遇辛水照 → 尤主内贤良（对宫相催给后劲）" />
          <outline text="口吐莲花教讲台，辛秀井水有源泉" />
          <outline text="乙辰马形骆驼峰 → 出富翁" />
          <outline text="乙庚两砂相合 → 文昌内发世无功" />
          <outline text="催文科，不催理科" />
          <outline text="应验：完形、阅读、文言、文艺解读" />
        </outline>
        <outline text="兼与叠加">
          <outline text="乙水＋辰水 → 婚姻受阻、乳房手术" />
          <outline text="乙水＋坤水 → 迷信、开天眼" />
          <outline text="乙庚两砂 → 吉则文昌，凶则文化自负" />
          <outline text="单辰砂无乙 → 搞垄断、明抢暗偷" />
        </outline>
        <outline text="技法">
          <outline text="书房最贵重书橱放乙山" />
          <outline text="孩子文科差：乙山立秀砂＋酉水" />
          <outline text="走艺术：乙砂＋申砂同做" />
          <outline text="想靠文化做企业：乙＋庚两砂相合" />
          <outline text="前提：整个震卦不能烂，单点补无用" />
        </outline>
        <outline text="我的经文与老师经文">
          <outline text="我的经文：〔待补〕" />
          <outline text="老师经文：〔待补〕" />
        </outline>
        <outline text="一句话：见砂读书教化内秀，见水浪漫过头活在幻想" />
      </outline>
      <outline text="六爻论断（老师版）">
        <outline text="卯木出现（震木龙）">
          <outline text="初爻 子孙：有吃有喝有斗，工作财运样样有" />
          <outline text="二爻 官鬼：青龙得位" />
          <outline text="三爻 官鬼 旺水：玄武临门户，旺水凡事顺遂" />
          <outline text="四爻 兄弟：玄武临兄弟" />
          <outline text="五爻 父母：勾陈临父母" />
          <outline text="六爻 父母：白虎临父母，主女出嫁" />
        </outline>
        <outline text="乙木出现">
          <outline text="世爻 子孙：临青龙，合家和睦邻居亦睦" />
          <outline text="兄弟 临青龙/玄武：破财" />
          <outline text="二爻 子孙：临青龙；三爻 父母：子女孝顺、文章名扬" />
        </outline>
        <outline text="持世应">
          <outline text="世爻 兄弟（申金）：主女出嫁，嫁贵夫、享荣华" />
          <outline text="应爻 兄弟（戌土）：男方上门，女方守空房" />
          <outline text="应爻 财动 生官鬼（男方上门）：男方有家底有钱" />
        </outline>
      </outline>
      <outline text="断卦次序">
        <outline text="一看甲：这个人还想不想干" />
        <outline text="二看卯：人脉是助力还是漏斗" />
        <outline text="三看乙：劲使在读书上还是幻想上" />
        <outline text="三山皆水：先看对宫兑，水则口舌、砂则官司手术" />
        <outline text="布局先看元运：上中元最灵，离九运先调离" />
        <outline text="分龄：二十调震、三十调坎、五十调坤" />
        <outline text="记住：震给不了起跑线，只给成长上限" />
      </outline>
    </outline>
  </body>
</opml>